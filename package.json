{
  "name": "ballarena",
  "private": true,
  "scripts": {
    "dev": "concurrently -n worker,frontend -c blue,green \"npm run dev:worker\" \"npm run dev:frontend\"",
    "dev:worker": "npm run dev --prefix worker",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "fetch:matches": "node scripts/fetch-premier-league-matches.mjs",
    "sync:matches": "node scripts/sync-premier-league-matches.mjs",
    "deploy:worker": "npm run deploy --prefix worker",
    "install:all": "npm install && npm install --prefix worker && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
